*.DS_Store
*~
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ---- MESA: binaries, build products, run output (data live on Ceph) ----
# (models/template/star and make/ were committed before these rules; they stay tracked)
models/*/star
models/*/make/*.o
models/*/make/*.mod
models/*/make/*.smod
models/**/.mesa_temp_cache/
models/**/LOGS
models/**/photos
models/**/rn.out
*.pre_mltvc

# Slurm / disBatch litter
*disBatch_*
disBatch_tasks.txt
grid_*.log
grid_*.err
rerun_*.log
rerun_*.err
slurm_job_*_resize.*

# Old pre-grid run directories (2026-09-22) and archived no-mass-loss logs
models/M[0-9]*/
models/old_nomassloss_logs/

# Per-model directories in the grids (regenerated by setup_grids*.sh; the real v1 rotating
# inlists were hand-edited, see models/GRID_LOG.md)
models/grids/*/w*/M*/
models/grids_v2/*/w*/M*/

# ---- analysis_mesa: large regenerable extracts (python3 extract_mesa.py) ----
analysis_mesa/data/mesa_ms*.csv
analysis_mesa/data/mesa_post*.csv
analysis_mesa/data/fig8_inputs.npz

# ---- handoff: keep text and small tables only ----
handoff/*.tar.gz
handoff/**/*.tar.gz
handoff/**/*.pdf
handoff/**/*.npz
handoff/**/*.parquet
handoff/**/*.csv.gz

# ---- LaTeX build products and backups ----
paper_apj/*.aux
paper_apj/*.bbl
paper_apj/*.blg
paper_apj/*.log
paper_apj/*.out
paper_apj/*.pre_mesa
